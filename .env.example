# Copy to .env.local. Leave the Firebase keys empty to run the portal on built-in sample data.
# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ZegoCloud console → your project → AppID / ServerSecret (TEST ONLY: the secret ships in the browser bundle)
VITE_ZEGO_APP_ID=
VITE_ZEGO_SERVER_SECRET=

# Public URL of this portal; patient video-call links point here (e.g. https://your-project.web.app)
VITE_PUBLIC_URL=
