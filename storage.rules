rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Doctor profile photos
    match /doctors/{uid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Lab reports, scans and prescriptions attached to medical records
    match /records/{patientId}/{file=**} {
      allow read: if request.auth != null && role() in ['admin', 'hospital_admin', 'doctor', 'receptionist'];
      allow write: if request.auth != null && role() in ['admin', 'hospital_admin', 'doctor', 'receptionist']
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
