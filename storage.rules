rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Doctor profile photos
    match /doctors/{uid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function ownsPatient(patientId) {
      return firestore.get(/databases/(default)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid;
    }

    // Lab reports, scans and prescriptions attached to medical records (patients: their own family's)
    match /records/{patientId}/{file=**} {
      allow read: if request.auth != null
        && (role() in ['admin', 'hospital_admin', 'doctor', 'receptionist'] || ownsPatient(patientId));
      allow write: if request.auth != null
        && (role() in ['admin', 'hospital_admin', 'doctor', 'receptionist'] || ownsPatient(patientId))
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Prescriptions uploaded with medicine orders: the patient writes, staff read.
    match /prescriptions/{uid}/{file=**} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || role() in ['admin', 'hospital_admin', 'doctor', 'receptionist', 'billing']);
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
